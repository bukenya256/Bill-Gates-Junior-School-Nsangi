{
  "name": "bgs-school-system",
  "version": "1.5.1",
  "description": "Bill Gates Junior School Nsangi \u2013 School Management System",
  "author": "Bill Gates Junior School Nsangi",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-core.js && node test-net.js && node test-recovery.js && node test-sms.js && node test-cloud-web-guard.js && node test-new-features.js",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ug.billgates.school",
    "productName": "BGS School System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "src/assets/bgs-icon.ico",
      "artifactName": "BGS-School-System-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BGS School System",
      "installerIcon": "src/assets/bgs-icon.ico",
      "uninstallerIcon": "src/assets/bgs-icon.ico"
    },
    "portable": {
      "artifactName": "BGS-School-System-Portable-${version}.${ext}"
    },
    "artifactName": "BGS-School-System-Setup-${version}.${ext}"
  }
}